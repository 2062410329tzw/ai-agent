# Offline mock mode needs no configuration.
# Copy to .env for live mode. Never commit .env or a real key.
QA_API_KEY=your-api-key
QA_BASE_URL=https://open.bigmodel.cn/api/paas/v4
QA_MODEL=glm-4.5-flash
QA_TIMEOUT=60
# Set omit for providers that do not accept the thinking field.
QA_THINKING=disabled
